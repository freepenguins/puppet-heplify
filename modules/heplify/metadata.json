{
  "name": "local-heplify",
  "version": "0.1.0",
  "author": "freepenguins",
  "summary": "Hiera-driven install and configuration of the HOMER heplify capture agent",
  "license": "Apache-2.0",
  "source": "https://github.com/freepenguins/puppet-heplify",
  "dependencies": [
    { "name": "puppetlabs/stdlib", "version_requirement": ">= 9.0.0 < 11.0.0" }
  ],
  "operatingsystem_support": [
    { "operatingsystem": "Debian" },
    { "operatingsystem": "Ubuntu" },
    { "operatingsystem": "RedHat" },
    { "operatingsystem": "Rocky" },
    { "operatingsystem": "AlmaLinux" }
  ],
  "requirements": [
    { "name": "puppet", "version_requirement": ">= 7.0.0 < 9.0.0" }
  ]
}
